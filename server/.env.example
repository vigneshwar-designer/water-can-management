# Server Port Configuration
PORT=5000

# MongoDB Connection URI (Required for permanent storage in production!)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/water-can
MONGODB_URI=mongodb://127.0.0.1:27017/water-can

# JWT Authentication Secret Key (Required for signing user session tokens)
# Ensure this is set to a long, secure random string in production!
JWT_SECRET=super_secret_water_can_token_key_12345
